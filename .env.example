# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY

# Server-only (never expose to the browser, never commit)
SUPABASE_SECRET_KEY=sb_secret_...       # or legacy SUPABASE_SERVICE_ROLE_KEY; used only for provider/AI caches and the isolated demo sandbox
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash            # any Gemini *Flash* model id; validated at startup
CRICKETDATA_API_KEY=                     # cricketdata.org free plan (100 hits/day)
